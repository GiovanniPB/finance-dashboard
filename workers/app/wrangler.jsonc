{
  // Dashboard (SPA) servido por Worker com Static Assets, em lugar do Cloudflare Pages.
  //
  // ⚠️ Este arquivo NÃO pode subir para a raiz do repositório enquanto o projeto do
  // Pages existir: na raiz, o build do Pages passa a lê-lo e ignora as variáveis de
  // build do dashboard — foi o que quebrou o deploy em 30/07/2026 (ver README).
  //
  // Não há `main` nem `binding`: isto é 100% estático, sem código de Worker. As
  // variáveis do app (VITE_*) são embutidas no bundle em tempo de BUILD, então quem
  // roda `bun run build` precisa tê-las no ambiente — é a diferença operacional em
  // relação ao Pages, que as injetava sozinho.
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "finance-dashboard",
  "compatibility_date": "2026-08-01",
  "assets": {
    "directory": "../../dist",
    // Rota desconhecida devolve index.html com 200. É ESTE campo que faz o
    // roteamento do SPA — e é a única forma que funciona aqui: o Workers valida
    // `_redirects` no deploy e REJEITA a regra `/* /index.html 200` do Pages como
    // loop infinito (erro 100324). Por isso o arquivo foi removido do repositório.
    "not_found_handling": "single-page-application"
  },
  "observability": { "enabled": true }
}
