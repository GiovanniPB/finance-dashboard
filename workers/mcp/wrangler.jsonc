{
  // ⚠️ Este arquivo NÃO pode subir para a raiz do repositório. O build do Cloudflare
  // Pages (que serve o SPA) lê um wrangler config na raiz e passa a ignorar as
  // variáveis de build do dashboard — foi o que quebrou o deploy em 30/07/2026.
  // Ver README, seção "Não adicione wrangler.toml a este projeto".
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "finance-mcp",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-01",
  "compatibility_flags": ["nodejs_compat"],
  // Superfície pública, explícita em vez de herdada. O wrangler avisa que liga as
  // duas por padrão quando elas não estão no arquivo — e "padrão" não é uma decisão.
  //
  // `workers_dev` fica true só até o domínio próprio existir; depois vire false, para
  // o servidor MCP não ficar acessível também num endereço *.workers.dev.
  "workers_dev": true,
  // URLs de preview são públicas e por versão: não valem o risco aqui.
  "preview_urls": false,

  "observability": { "enabled": true },
  // Valores de PRODUÇÃO, e nenhum é segredo: são as mesmas chaves públicas que o
  // front embute no bundle. Ficam aqui, e não no dashboard, porque `wrangler deploy`
  // sobrescreve as variáveis do dashboard com o que está neste arquivo — deixá-las
  // só lá significa perdê-las no próximo deploy.
  //
  // Para rodar local, crie `workers/mcp/.dev.vars` (git-ignored) apontando para o
  // stack local; ele tem precedência no `wrangler dev`. Ver `.dev.vars.example`.
  //
  // MCP_RESOURCE_URL não aparece aqui de propósito: o Worker usa a origem da própria
  // requisição. Só defina para forçar outro valor.
  "vars": {
    "SUPABASE_URL": "https://vbeevkjenvgvnattzszt.supabase.co",
    "SUPABASE_ANON_KEY": "sb_publishable_cle8GUgb1wIC_LkqBtoPhw_ZAO6ZQxB"
  }
}
